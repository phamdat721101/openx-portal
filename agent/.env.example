OPENX_GATEWAY_URL=http://localhost:7411
OPENX_AGENT_ID=<returned-by-registration>
# Inject from the process environment or secret manager: ${OPENX_AGENT_KEY}
OPENX_AGENT_KEY=<one-time-key-stored-in-your-secret-manager>
OPENX_MODEL=gemini-3.5
OPENX_PLAN_ID=starter
# The researcher is the only The Graph caller. Blank configuration emits an
# explicit degraded report; it never claims successful synthetic telemetry.
OPENX_GRAPH_TIMEOUT_SECONDS=3.5
OPENX_GRAPH_MORPHO_URL=
OPENX_GRAPH_MORPHO_API_KEY=
OPENX_GRAPH_MORPHO_MARKET_ID=
# Canonical Aave V3 Arbitrum deployment. Store the key only in the runtime
# secret manager; it is sent as Authorization: Bearer and is never reported.
OPENX_GRAPH_AAVE_URL=https://gateway.thegraph.com/api/subgraphs/id/4xyasjQeREe7PxnF6wVdobZvCw5mhoHZq3T7guRpuNPf
OPENX_GRAPH_AAVE_API_KEY=
# Verified market entity from the canonical deployment: Aave Arbitrum USDCn.
OPENX_GRAPH_AAVE_MARKET_ID=0x724dc807b04555b71ed48a6896b6f41593b8c637
