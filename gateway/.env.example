# Local development is loopback-only and accepts anonymous telemetry for discovery.
OPENX_AGENT_REGISTRATION_MODE=development
OPENX_ALLOW_ANONYMOUS_TELEMETRY=true
OPENX_AGENT_ONLINE_WINDOW_SECONDS=90
# Set an absolute writable path in a real deployment; do not commit the generated file.
OPENX_AGENT_REGISTRY_PATH=.openx/agent-registry.json

# Production requires a server-side OpenX Core-issued connect token verifier.
# OPENX_AGENT_REGISTRATION_MODE=production
# OPENX_CONNECT_TOKEN=<injected-by-secret-manager>
