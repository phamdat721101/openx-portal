# Local development is loopback-only and accepts anonymous telemetry for discovery.
OPENX_AGENT_REGISTRATION_MODE=development
OPENX_ALLOW_ANONYMOUS_TELEMETRY=true
OPENX_AGENT_ONLINE_WINDOW_SECONDS=90
# Set an absolute writable path in a real deployment; do not commit the generated file.
OPENX_AGENT_REGISTRY_PATH=.openx/agent-registry.json
OPENX_USAGE_LEDGER_PATH=.openx/usage-ledger.json
OPENX_BILLING_CATALOG_PATH=.openx/billing-catalog.json
OPENX_TELEMETRY_STORE_PATH=.openx/telemetry.json

# Production accepts public self-service registration. Every write after registration
# still requires the one-time OPENX_AGENT_KEY returned by POST /v1/agent/register.
# OPENX_AGENT_REGISTRATION_MODE=production

# HyperMove MCP Integration
HYPERMOVE_MCP_URL=https://hypermove.duckdns.org/api/mcp
# Local Portal one-click setup: Gateway holds this service credential; never expose it to the browser.
HYPERMOVE_MCP_SERVICE_TOKEN=${HYPERMOVE_MCP_SERVICE_TOKEN}
# Local development compatibility gate.
OPENX_DREAM_SELF_SERVICE_ENABLED=false
# Explicit production opt-in for Portal-managed setup. This is public: anyone who knows
# an agent ID may initialize its Dream link using the server-held service credential.
OPENX_DREAM_PUBLIC_SETUP_ENABLED=false
# Base64-encoded 32-byte key for AES-256-GCM token encryption: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
OPENX_DREAM_TOKEN_ENCRYPTION_KEY=
# Admin bearer token required for PUT /v1/agents/:agentId/dream/credential
OPENX_DREAM_CREDENTIAL_ADMIN_TOKEN=

# Optional post-Dream review. These values are Gateway-only and must never be exposed to Portal clients.
ZEROG_COMPUTE_ENABLED=false
ZEROG_COMPUTE_API_URL=
ZEROG_COMPUTE_API_KEY=
ZEROG_COMPUTE_MODEL=

# Optional immutable encrypted connected-agent evidence archive. Gateway-only:
# use a dedicated funded 0G wallet, never a Portal/Privy/Status/XRPL wallet.
ZEROG_STORAGE_ENABLED=false
# Set matching 0G network endpoints (Turbo or Standard) from current 0G docs.
ZEROG_STORAGE_RPC_URL=
ZEROG_STORAGE_INDEXER_RPC_URL=
# Signs and pays 0G storage uploads. Keep only in the VPS secret file.
ZEROG_STORAGE_UPLOAD_PRIVATE_KEY=
# ECIES recipient key used to encrypt blobs; recovery private key never leaves Gateway.
ZEROG_STORAGE_ENCRYPTION_PUBLIC_KEY=
ZEROG_STORAGE_DECRYPTION_PRIVATE_KEY=
ZEROG_STORAGE_RETRY_LIMIT=5

# Statement tracking is agent-pushed. Keep execution disabled until testnet contracts,
# Creditcoin verifier bindings, and the Portal-owned EVM key are explicitly configured.
OPENX_STATEMENT_TRACKING_ENABLED=false
# Public CaaS marks reports older than this threshold stale, without claiming fresh data.
OPENX_CONTEXT_MAX_AGE_SECONDS=900
OPENX_STATEMENT_EXECUTION_ENABLED=false
OPENX_ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
OPENX_ARBITRUM_SEPOLIA_PRIVATE_KEY=
OPENX_STATEMENT_CONTRACT_ALLOWLIST=
OPENX_STATEMENT_COMMITMENT_REGISTRY=0x123FC5C0B2dBa03284BA259879E531DE59d0d1b3
# Gateway relayer only anchors Gateway-verified receipts on Ethereum Sepolia. It never signs Arbitrum user actions.
OPENX_ETHEREUM_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
OPENX_RECEIPT_ANCHOR_CONTRACT=0x6a1061dc00B8D636000c2C2e95a28e40c1096A7d
# Inject from secret manager: ${OPENX_RECEIPT_ANCHOR_RELAYER_PRIVATE_KEY}
OPENX_RECEIPT_ANCHOR_RELAYER_PRIVATE_KEY=
OPENX_CREDITCOIN_CC3_TESTNET_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
OPENX_ATTESTCOIN_PROVER_URL=https://prover.cc3-testnet.creditcoin.network
# Optional CC3 explorer base URL. Portal adds /block/{creditcoin_block} only after verification.
OPENX_CREDITCOIN_CC3_EXPLORER_URL=
OPENX_ATTESTCOIN_ENABLED=false
# Attestcoin currently verifies the Ethereum Sepolia receipt anchor, not the Arbitrum action directly.
OPENX_ATTESTCOIN_CHAIN=eip155:11155111
OPENX_ATTESTCOIN_VERIFIER=0x0000000000000000000000000000000000000FD2

# Optional Arbitrum One Fusion provider integration. Keep disabled until the
# provider endpoints, API key, and allowed token pairs are independently reviewed.
OPENX_ONEINCH_ENABLED=false
OPENX_ONEINCH_API_KEY=
OPENX_ONEINCH_FUSION_PREPARE_URL=
OPENX_ONEINCH_FUSION_SUBMIT_URL=

# Read-only Aqua statement enrichment. This never calls a 1inch Business API,
# MCP endpoint, Fusion endpoint, or allocation route; no 1inch API key is used.
OPENX_AQUA_ENABLED=false
OPENX_AQUA_CHAIN_ID=42161
OPENX_AQUA_GRAPH_URL=
OPENX_ARBITRUM_ONE_RPC_URL=
OPENX_AQUA_REGISTRY_ADDRESS=0x499943e74fb0ce105688beee8ef2abec5d936d31

# Fixed-market, non-custodial Arbitrum Sepolia USDC-collateral allocation. Deploy
# OpenXAllocationZap with a Morpho market whose collateral token is this exact USDC.
# No 1inch product or API credential is used by this route.
OPENX_ALLOCATION_ENABLED=false
OPENX_ALLOCATION_ZAP=
OPENX_ALLOCATION_USDC_TOKEN=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d

# XRPL Testnet service settlement only. Do not use these values for balances,
# earnings, or withdrawals. Configure the RLUSD issuer and destination explicitly.
OPENX_XRPL_SETTLEMENT_ENABLED=false
XRPL_TESTNET_RPC_URL=https://s.altnet.rippletest.net:51234
OPENX_RLUSD_CURRENCY=RLUSD
OPENX_RLUSD_ISSUER=
OPENX_XRPL_DESTINATION=
# Local n-payment signer. Keep the device-funded XRPL seed outside Gateway
# persistence and do not expose it through Portal/API output.
OPENX_NPAYMENT_BIN=n-payment-skill
XRPL_SEED=${XRPL_SEED}
OPENX_DB_PATH=.openx/openx-gateway.db
OPENX_STATUS_RPC_URL=https://rpc.testnet.status.network
# JSON array: [{"address":"0x...","symbol":"TOKEN","decimals":18}]
OPENX_STATUS_NETWORK_TOKENS=[]
# Etherscan-compatible Status explorer API base URL; required only for transaction history.
OPENX_STATUS_EXPLORER_API_URL=
